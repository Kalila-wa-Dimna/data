{"id":"eb45373a-c063-4298-a06a-dd2171eb29b0","number":4,"manuscript":"P3465-Mc-English","imageUrl":"5af71a68-bd43-4fd9-a650-9df6195cc2d2/4.jpg","lines":[["the","ship","is","delivered.’”","“When","the","cat","comprehended","the","talk","by","the","rat,","he","knew","that","he","was","truthful","and","said","to","him,"],["‘Your","words","are,","indeed,","akin","to","the","truth.","I,","too,","am","desirous","of","this","truce,","in","which","for","you","and","for","myself,","I","hope,","will","be","deliverance.","And","if","you"],["do","this,","I","will","thank","you","as","long","as","I","live.","The","rat","said:","I","shall","approach","you","and","cut"],["all","your","cords,","except","for","one","cord,","which","I","shall","keep","to","secure","myself","against","you.’”","“He","then","took","to","gnawing","at","his","cords."],["When","the","owl","and","the","mongoose","saw","the","rat","approach","the","cat,","they","gave","up","on","catching","him","and","left.","But","the"],["rat","held","some","speed","from","Rūmī","while","cutting","the","cords,","so","Rūmī","said:","‘Why","do","I","not","see","you","being","diligent","at","cutting","my","cords."]],"unitPlaces":[[3,16],[4,0],[0,4],[3,17],[2,11]],"unitNames":[["Mc The Foes Leave Frustrated",39],["Mc The Cat Deems the Rat's Efforts Slow",42],["Mc The Cat Puts His Trust in the Rat",34],["Mc The Rat Begins to Cut the Rope",41],["Mc The Rat Explains the Detail of the Last Rope",36]]}