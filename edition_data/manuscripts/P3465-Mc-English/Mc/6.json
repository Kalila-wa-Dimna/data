{"id":"9b838fa4-0bbe-4708-a0c1-2e191666b51b","number":6,"manuscript":"P3465-Mc-English","imageUrl":"5af71a68-bd43-4fd9-a650-9df6195cc2d2/6.jpg","lines":[["with","the","best","for","the","service","you","have","done","me","Do","come","to","me","and","don’t","sever","my","brotherly","ties;","for","he","who","takes","a","friend,"],["and","cuts","off","any","brotherly","connections","and","loses","his","friendship,","will","be","prevented","from","reaping","the","fruits","of","his","brotherhood;","and","know","that","what","I","owe","you","will","be"],["bestowed","upon","you.’”","“The","rat","cried","back","‘Many","an","open","friendship","is","deep","down","a","hidden","enmity,","which","is"],["more","harmful","than","open","enmity,","and","its","outcome","is","similar","to","that","of","a","man","who","rides","the","tusk","of","a","rutting","elephant"],["then","falls","asleep,","topples","over,","and","perishes.","Now","the","friend","is","called","a","friend","precisely","for","the","benefits","one","hopes"],["to","gain","from","him,","and","the","enemy","is","called","an","enemy","for","the","damage","one","fears","from","him;","so","when","the","sensible","man","hopes"],["to","benefit","from","the","enemy,","he","shows","him","friendship.","Don’t","you","see","how","the","offspring","of","animals","follow","their","mothers","hoping","for","their","milk,","but"]],"unitPlaces":[[2,3],[4,7],[0,20],[6,10],[1,20],[3,5]],"unitNames":[["Mc The Rat Distinguishes Hidden from Overt Enmity",77],["Mc An Enemy Is Befriended in Times of Need",80],["Mc If One Gives Up a Friend One Loses Out",73],["Mc Young Cattle Only Nurse for a While",82],["Mc The Cat Suggests a Reward",74],["Mc Riding an Elephant's Tusk",79]]}