{"id":"35743643-93b9-474a-9e8b-9ebf8c88ae60","number":1,"manuscript":"P400-Mc-English","imageUrl":"44c36c1b-50f4-4579-a99b-e0ec820bb32c/1.jpg","lines":[["for","the","outcome","of","patience","and","prudence","is","praised","by","people","who","look","into."],["and","weigh","the","matters","whose","benefit","or","harm","is","known"],["The","Chapter","of","the","Cat","and","Rat"],["“I","have","understood","what","you","mentioned","of","the","matters","of","government","and","reason,”","said","the","King","to","the","Philosopher,"],["“and","how","a","man","of","both","stands","to","benefit.","Now,","tell","me","the","parable","of","the","man","who,","outnumbered","by","enemies"],["and","on","the","brink","of","perishing,","sought","a","way","out","through","reconciling","with","one","of","them,","was","saved","from","that","which","had","frightened","him,","and","kept","his","promise"]],"unitPlaces":[[2,0],[3,0]],"unitNames":[["Mc Chapter Title",1],["Mc The King Asks about Escaping Enemies",3]]}