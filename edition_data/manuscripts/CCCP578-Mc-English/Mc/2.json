{"id":"c453aaa0-3e43-4622-a646-74c8c64b7c13","number":2,"manuscript":"CCCP578-Mc-English","imageUrl":"ed722fae-dc0e-4355-a4e0-2d448bd669d3/2.jpg","lines":[["the","den","of","a","cat","named","Rūmī.","The","hunters","of","that","land","went","every","day","to","valleys","and","other","sites"],["to","find","game","from","which","to","benefit.","One","day","they","passed","that","very","tree","and","noticed","that"],["fowl","and","wild","animals","took","shelter","there;","and","so","they","started","to","that","place","at","all","times","and","every","time"],["“One","day,”","he","continued,","“one","of","them","came","and","set","his","snares,","into","which","fell"],["the","cat","whose","name","was","Rūmī!”He","said:","“As","the","cat","fell","into","the","snares,","the","rat","was","coming","out"],["to","seek","some","nourishment.","Upon","seeing","the","cat","in","the","snares,","he","became","afraid","for"],["himself,","turning","left","and","right.","Then","saw","the","cat","in","the","snares","and","rejoiced"],["greatly","at","that,","as","if","he","fell","upon","an","opportunity.","While","joyful,","he","happened","to","look","behind","and","suddenly","saw","a","mongoose;"],["he","then","raised","his","eye","toward","the","tree","and","saw","an","owl","on","the","tree.","And","so,","he","feared","for","himself:","if","he","turned","back,"],["the","mongoose","would","jump","on","him","and","if","he","stepped","forward,","the","cat","would","take","him.","‘These","are","troubles","that","have","besieged","me,’","he","said,","‘",",and","evils","that"]],"unitPlaces":[[9,16],[7,10],[4,14],[0,8]],"unitNames":[["Mc The Rat Weighs His Predicament",16],["Mc Foes Surround the Rat",15],["Mc The Rat Seeks Food",14],["Mc The Cat Is Caught",13]]}