{"id":"93cba1e7-1334-4e6b-aa3b-b7f8dcc1189e","number":3,"manuscript":"P3466-Mc-English","imageUrl":"bbb3e058-189e-4195-bd19-9bce6572881f/3.jpg","lines":[["“And","how","was","that?”","said","the","King.","“The","claim","goes,”","said","the","Philosopher,","“that"],["in","such-and-such","a","place","there","was","a","great","yabrūṭ","tree","at","whose","foot"],["was","the","burrow","of","a","rat","called","Fayrūz","and","near","that","site","was","the","dwelling","of","a"],["cat","named","Rūmī.","Huntsmen","occasionally","sought"],["game","and","fowl","near","that","tree;","and","that","one","day","one","such","huntsman","set","a","snare","of","his"],["into","which","the","cat","fell.","“The","rat","came","out","creeping,","to","seek","something","to","eat,"],["yet","all","the","while","cautious,","turning","around,","surveying;","upon","seeing","the","cat","trapped"],["in","the","snares,","he","rejoiced","at","it.","He","then","turned","behind","him","and","saw","that","a","mongoose"],["had","tracked","him","and","lay","in","wait;","and","looking","over","his","head,","he","saw","an","owl,","atop","the","tree,","watching","him."],["And","so","he","feared-that","if","he","turned","back,","the","mongoose","would","jump","on","him;","that","if","he","moved"],["left","or","right,","the","owl","would","snatch","him;","and","that","if","he","stepped","forward"],["the","cat","would","eat","him.","‘These","are","troubles","that","have","besieged","me,’","he","said,"],["“and","evils","that","have","come","upon","me","in","succession,","and","I","have","no","resort","but","to","my","sense","and","ingenuity.","I","should","not","be","overtaken","by","confusion,"],["and","my","intelligence","must","not","be","scattered","in","dismay].","The","sensible","man","does","not","lose","judgment,","and","his","intelligence"],["does","not","abandon","him,","whatever","the","circumstance;","for","the","minds","of","the","intelligent","are","like","the","sea"],["whose","depth","cannot","be","reached.","Trouble","does","not","affect","the","level-headed","man’s","capacities","as","to","cause","him","to","perish;"],["nor","should","hope","affect","him","to","a","point","where","he","is","made","complacent,","intoxicated,","and","blind","to","his"],[]],"unitPlaces":[[0,0],[7,7],[11,5],[0,8],[3,3],[13,9],[14,7],[5,5],[15,5]],"unitNames":[["Mc The King Requests the Full Parable",11],["Mc Foes Surround the Rat",15],["Mc The Rat Weighs His Predicament",16],["Mc The Rat and the Cat Live Next to a Tree",12],["Mc The Cat Is Caught",13],["Mc The Intelligent Always Keeps Alert",18],["Mc Intelligence Is Like the Sea",19],["Mc The Rat Seeks Food",14],["Mc Situations Do Not Blind the Intelligent",20]]}