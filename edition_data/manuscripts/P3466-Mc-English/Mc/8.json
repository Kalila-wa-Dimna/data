{"id":"fb4a8f01-db74-4da0-abf0-0ac1cd87e150","number":8,"manuscript":"P3466-Mc-English","imageUrl":"bbb3e058-189e-4195-bd19-9bce6572881f/8.jpg","lines":[["When","the","cat","saw","him,","he","sensed","perdition.","So","the","rat","said","to","the","cat,"],["‘now","is","the","place","for","diligence","in","cutting","what","remains","of","your","cords.’”","“Before","the","huntsman","came","close,"],["the","rat","had","finished","cutting","the","cords,","despite","the","cat’s","mistrust","and","his","perplexity.”","“When","he","finished,"],["the","cat","ran","to","the","tree","and","climbed","it,","the","rat","dived","into"],["his","burrow],","and","the","huntsman","grabbed","his","shredded","cords","and","net","and","left","feeling","disappointed.”","The","rat","came","out"],["of","his","burrow","after","that,","saw","the","cat","from","afar","and","dreaded","approaching","him."],["‘O,","friend,’","therefore","cried","the","cat,","‘you","who","have","done","me","a","good","deed","What"],["is","stopping","you","from","approaching","me,","so","that","I","can","endow","you","with","the","best","for","the","favor","you","have","done","me","Do","come","to","me"],["and","don’t","sever","my","brotherly","ties;","for","he","who","takes","a","friend","and","cuts","off","any","brotherly","connections"],["will","be","prevented","from","reaping","the","fruits","of","friendship","and","brotherhood,","and","brethren","and","friends","will","despair","from","obtaining","benefits","from","him."],["Your","favor","to","me","cannot","be","forgotten,","and","you","are","entitled","to","seek","the","reward"]],"unitPlaces":[[1,13],[4,15],[8,6],[0,8],[0,0],[10,0],[2,14],[7,0]],"unitNames":[["Mc The Rat Fulfills the Pact",67],["Mc The Cat Calls Back the Rat",70],["Mc If One Gives Up a Friend One Loses Out",73],["Mc The Rat Resolves to Cut the Last Rope",66],["Mc The Cat Expects to Die",64],["Mc The Cat Suggests a Reward",74],["Mc The Cat and the Rat Escape",69],["Mc The Cat Reminds the Rat o